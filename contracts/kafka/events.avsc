[
  {
    "type": "record",
    "name": "DossierBuilt",
    "namespace": "arca.cert",
    "doc": "Emitted when a dossier is built.",
    "fields": [
      {
        "name": "dossier_id",
        "type": "str"
      },
      {
        "name": "target",
        "type": "str"
      },
      {
        "name": "built_at",
        "type": "str"
      }
    ]
  },
  {
    "type": "record",
    "name": "DossierPublished",
    "namespace": "arca.cert",
    "doc": "Emitted when a dossier is published.",
    "fields": [
      {
        "name": "dossier_id",
        "type": "str"
      },
      {
        "name": "reviewer",
        "type": "str"
      },
      {
        "name": "valid_until",
        "type": "str"
      }
    ]
  },
  {
    "type": "record",
    "name": "RemediationIssued",
    "namespace": "arca.cert",
    "doc": "Emitted when a remediation plan is issued.",
    "fields": [
      {
        "name": "dossier_id",
        "type": "str"
      },
      {
        "name": "item_count",
        "type": "int"
      },
      {
        "name": "issued_at",
        "type": "str"
      }
    ]
  },
  {
    "type": "record",
    "name": "BenchResults",
    "namespace": "arca.cert",
    "doc": "bench.results — benchmark results have been published.",
    "fields": [
      {
        "name": "event_id",
        "type": "string",
        "doc": "Event UUID"
      },
      {
        "name": "correlation_id",
        "type": "string",
        "doc": "Correlation ID (Evidence)"
      },
      {
        "name": "occurred_at",
        "type": "string",
        "doc": "ISO-8601 UTC timestamp"
      },
      {
        "name": "actor",
        "type": [
          "null",
          "string"
        ],
        "default": null,
        "doc": "Actor (OIDC sub) or SPIFFE workload"
      },
      {
        "name": "payload",
        "type": {
          "type": "record",
          "name": "BenchResultsPayload",
          "fields": [
            {
              "name": "bench_id",
              "type": "string"
            },
            {
              "name": "target",
              "type": "string"
            },
            {
              "name": "dimension",
              "type": "string"
            },
            {
              "name": "passed",
              "type": "boolean"
            },
            {
              "name": "score",
              "type": "double"
            },
            {
              "name": "evidence",
              "type": {
                "type": "array",
                "items": {
                  "type": "record",
                  "name": "EvidenceRef",
                  "fields": [
                    {
                      "name": "source",
                      "type": "string"
                    },
                    {
                      "name": "ref_id",
                      "type": "string"
                    },
                    {
                      "name": "description",
                      "type": "string"
                    }
                  ]
                }
              }
            }
          ]
        },
        "doc": "Benchmark results payload"
      }
    ]
  },
  {
    "type": "record",
    "name": "AssetPublished",
    "namespace": "arca.cert",
    "doc": "Emitted when a certification package is published as an asset.",
    "fields": [
      {
        "name": "asset_id",
        "type": "str"
      },
      {
        "name": "name",
        "type": "str"
      },
      {
        "name": "version",
        "type": "str"
      },
      {
        "name": "trust_level",
        "type": "str"
      },
      {
        "name": "source",
        "type": "str"
      }
    ]
  }
]
